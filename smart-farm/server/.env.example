# ============================================================
#  Smart Farm Server - ตั้งค่าก่อนใช้งาน
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าต่างๆ
# ============================================================

# ชื่อผู้ใช้และรหัสผ่านสำหรับเข้าระบบ
ADMIN_USER=admin
ADMIN_PASS=farm1234

# Secret key สำหรับ session (เปลี่ยนเป็นค่าสุ่มที่คาดเดายาก)
SESSION_SECRET=smart-farm-secret-key-change-this-to-random-string

# Port (Railway/Render จะกำหนดให้อัตโนมัติ ไม่ต้องแก้)
PORT=3000

# ============================================================
#  Supabase — ที่เก็บข้อมูลรอบปลูกถาวร (ไม่ใส่ก็ได้)
#
#  ทำไมต้องมี: Render free instance ต่อ persistent disk ไม่ได้ ไฟล์ที่เขียนตอนรัน
#  หายทุกครั้งที่ redeploy / restart / spin down (หลังไม่มี traffic 15 นาที)
#  รอบปลูกใช้เวลา ~20 วัน จึงต้องเก็บนอกเครื่อง
#
#  ถ้าไม่ใส่ 2 ค่านี้ ระบบจะเก็บลงไฟล์ใน data/crops/ เหมือนเดิม (เหมาะกับรันในเครื่อง)
#
#  วิธีได้ค่า: supabase.com → สร้าง project ฟรี → Project Settings → API
#    SUPABASE_URL         = Project URL
#    SUPABASE_SERVICE_KEY = service_role key (ไม่ใช่ anon key)
#  ⚠️ service_role key ข้ามสิทธิ์ทั้งหมด ห้ามเอาไปใส่ในโค้ดฝั่งเบราว์เซอร์เด็ดขาด
#  แล้วรัน supabase-setup.sql ใน SQL Editor ของ Supabase หนึ่งครั้งเพื่อสร้างตาราง
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
